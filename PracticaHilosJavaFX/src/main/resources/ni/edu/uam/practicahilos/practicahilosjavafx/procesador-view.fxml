<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.practicahilosjavafx.ProcesadorController"
      alignment="CENTER" spacing="18" prefWidth="580" prefHeight="460">
    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Monitor de Procesos - NicaData Solutions" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- SECCIÓN CLIENTES (100 registros) -->
    <VBox spacing="8" style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-padding: 12;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Clientes (100 reg.):" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblEstadoClientes" text="Esperando inicio"/>
        </HBox>
        <ProgressBar fx:id="barraClientes" progress="0" prefWidth="500"/>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label fx:id="lblPorcentajeClientes" text="0% (0/100)" prefWidth="120"/>
            <Button fx:id="btnIniciarClientes" text="Iniciar Clientes" onAction="#iniciarClientes"/>
            <Button fx:id="btnDetenerClientes" text="Detener Clientes" onAction="#detenerClientes" disable="true"/>
        </HBox>
    </VBox>

    <!-- SECCIÓN PRODUCTOS (50 registros) -->
    <VBox spacing="8" style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-padding: 12;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Productos (50 reg.):" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblEstadoProductos" text="Esperando inicio"/>
        </HBox>
        <ProgressBar fx:id="barraProductos" progress="0" prefWidth="500"/>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label fx:id="lblPorcentajeProductos" text="0% (0/50)" prefWidth="120"/>
            <Button fx:id="btnIniciarProductos" text="Iniciar Productos" onAction="#iniciarProductos"/>
            <Button fx:id="btnDetenerProductos" text="Detener Productos" onAction="#detenerProductos" disable="true"/>
        </HBox>
    </VBox>

    <!-- BOTONES GENERALES -->
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="btnSimularAmbos" text="Simular Ambos" onAction="#simularAmbos" style="-fx-font-weight: bold;"/>
        <Button fx:id="btnReiniciar" text="Reiniciar" onAction="#reiniciarProceso"/>
    </HBox>
</VBox>